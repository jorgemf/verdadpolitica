---
// Expediente de un partido en la portada: qué propone, qué pasó con lo que
// prometió y cómo van sus causas judiciales. Todos los partidos usan la misma
// estructura; el detalle completo está en la página del partido.
import {
  CATEGORIA_INFO,
  COHERENCIA,
  COLOR_CATEGORIA,
  FASES_JUDICIALES,
  LEGISLATURA,
  AMBITO,
  situacionJudicial,
  porDesenlace,
  fichaUrl,
  partidoUrl,
  type Ficha,
  type Partido,
  type EntradaPrograma,
  type TemaConPreocupacion,
} from '../lib/datos';

interface Props {
  partido: Partido;
  fichas: Ficha[];
  programa: EntradaPrograma[];
  temas: TemaConPreocupacion[];
}

const MAX_FICHAS = 3;
const MAX_CAUSAS = 6;

const { partido: p, fichas, programa, temas } = Astro.props;
const d = p.data;

const CATS = ['cumplido', 'bloqueado', 'no-intentado', 'contradiccion'] as const;
const grupos = CATS.map((cat) => ({ cat, items: fichas.filter((f) => f.data.categoria === cat) }));
const total = grupos.reduce((n, g) => n + g.items.length, 0);
const barraTexto = grupos.map((g) => `${g.items.length} ${COLOR_CATEGORIA[g.cat].corto}`).join(', ');

const propuestas = temas
  .map((t) => ({ tema: t, entrada: programa.find((e) => e.data.tema === t.id) }))
  .filter((x) => x.entrada);

const causas = fichas
  .filter((f) => f.data.categoria === 'judicial')
  .sort(porDesenlace)
  .map((f) => ({ ficha: f, ...situacionJudicial(f.data.estadoJudicial!, f.data.faseJudicial) }));
const enCurso = causas.filter((c) => c.desenlace === 'curso').length;
const condenas = causas.filter((c) => c.desenlace === 'condena' || c.desenlace === 'condena-no-firme');
const firmes = condenas.filter((c) => c.desenlace === 'condena').length;
const favorables = causas.filter((c) => c.desenlace === 'favorable' || c.desenlace === 'favorable-no-firme').length;
const textoCondenas =
  condenas.length === 0
    ? 'condenas'
    : firmes === condenas.length
      ? firmes === 1
        ? 'condena firme'
        : 'condenas firmes'
      : firmes === 0
        ? 'no firmes'
        : `${firmes} ${firmes === 1 ? 'firme' : 'firmes'}, ${condenas.length - firmes} no ${condenas.length - firmes === 1 ? 'firme' : 'firmes'}`;

const claseFase = (fase: number, actual: number, desenlace: string) =>
  fase < actual ? 'paso--hecho' : fase === actual ? `paso--${desenlace}` : desenlace === 'curso' ? '' : 'paso--cerrado';

// Lo más importante se ve siempre; el resto, en un segundo clic.
const lotes = <T,>(items: T[], max: number) => [items.slice(0, max), items.slice(max)] as const;

const metaFicha = (f: Ficha) =>
  [f.data.legislatura === 'XIV' ? LEGISLATURA.XIV : null, f.data.ambito !== 'estatal' ? AMBITO[f.data.ambito] : null]
    .filter(Boolean)
    .join(', ');
---

<article class="exp" id={p.id} data-expediente style={`--c:${d.color}`}>
  <div class="exp__cabeza">
    <div class="exp__quien">
      <h2><a href={partidoUrl(p.id)}>{d.siglas}</a></h2>
      <p class="exp__candidato">{d.candidato}</p>
      <p class="exp__escanos">
        {d.escanos2023} escaños en 2023, {d.encuesta.escanos} en las encuestas
      </p>
    </div>

    <div class="exp__balance">
      <p class="exp__rotulo">Qué pasó con sus {total} promesas documentadas</p>
      <div class="barra" role="img" aria-label={barraTexto}>
        {
          grupos
            .filter((g) => g.items.length > 0)
            .map((g) => (
              <span
                style={`flex-grow:${g.items.length};background:${COLOR_CATEGORIA[g.cat].fondo};color:${COLOR_CATEGORIA[g.cat].texto}`}
              >
                {g.items.length}
              </span>
            ))
        }
      </div>
      <p class="barra__leyenda">
        {
          grupos.map((g) => (
            <span>
              <i style={`background:${COLOR_CATEGORIA[g.cat].fondo}`} />
              <b>{g.items.length}</b> {COLOR_CATEGORIA[g.cat].corto}
            </span>
          ))
        }
      </p>
    </div>

    <div class="exp__judicial">
      <p class="exp__rotulo">Causas judiciales</p>
      <div class="contadores">
        <span class="contador contador--curso"><b>{enCurso}</b> en curso</span>
        <span class:list={['contador', { 'contador--condena': condenas.length > 0 }]}>
          <b>{condenas.length}</b>
          {textoCondenas}
        </span>
        <span class:list={['contador', { 'contador--favorable': favorables > 0 }]}>
          <b>{favorables}</b> absuelto, archivado o anulado
        </span>
      </div>
    </div>
  </div>

  <div class="exp__cuerpo">
    <section class="exp__programa" aria-labelledby={`prop-${p.id}`}>
      <h3 id={`prop-${p.id}`}>Lo que propone para el 29-N</h3>
      <ul>
        {
          propuestas.map(({ tema, entrada }) => (
            <li>
              <span class="exp__tema">{tema.nombre}</span>
              <span class="exp__propuesta">{entrada!.data.propuesta}</span>
              <span
                class={`coherencia coherencia--${entrada!.data.coherencia}`}
                title={COHERENCIA[entrada!.data.coherencia].descripcion}
              >
                {COHERENCIA[entrada!.data.coherencia].texto}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="exp__hechos" aria-labelledby={`hechos-${p.id}`}>
      <h3 id={`hechos-${p.id}`}>Qué hizo con lo que prometió</h3>
      {
        grupos.map(({ cat, items }) => (
          <div class="grupo">
            <p class="grupo__titulo">
              <i style={`background:${COLOR_CATEGORIA[cat].fondo}`} />
              {CATEGORIA_INFO[cat].titulo}
              <span>{items.length}</span>
            </p>
            {items.length === 0 ? (
              <p class="grupo__vacio">No se ha encontrado ninguna.</p>
            ) : (
              lotes(items, MAX_FICHAS).map((lote, i) => {
                const lis = lote.map((f) => (
                  <li>
                    <a href={fichaUrl(f)}>{f.data.titulo}</a>
                    {metaFicha(f) && <span class="grupo__meta">{metaFicha(f)}</span>}
                  </li>
                ));
                return i === 0 ? (
                  <ul>{lis}</ul>
                ) : (
                  lote.length > 0 && (
                    <details class="mas">
                      <summary>
                        <span class="mas__ver">Ver {lote.length === 1 ? 'otra' : `${lote.length} más`}</span>
                        <span class="mas__ocultar">Ocultar</span>
                      </summary>
                      <ul>{lis}</ul>
                    </details>
                  )
                );
              })
            )}
          </div>
        ))
      }
    </section>
  </div>

  <section class="exp__causas" aria-labelledby={`jud-${p.id}`}>
    <div class="exp__causas-cabeza">
      <h3 id={`jud-${p.id}`}>Frentes judiciales</h3>
      <p>Sin condena firme rige la presunción de inocencia.</p>
    </div>
    {
      causas.length === 0 ? (
        <p class="grupo__vacio">No hay causas documentadas.</p>
      ) : (
        <>
          <div class="causa causa--leyenda" aria-hidden="true">
            <span>Caso</span>
            <span class="fases">
              {FASES_JUDICIALES.map((f) => (
                <span>{f}</span>
              ))}
            </span>
            <span>Situación</span>
          </div>
          {lotes(causas, MAX_CAUSAS).map((lote, n) => {
            const lis = lote.map((c) => (
              <li class={`causa causa--${c.desenlace}`}>
                <a href={fichaUrl(c.ficha)}>{c.ficha.data.titulo}</a>
                <span class="pasos" role="img" aria-label={`Fase: ${FASES_JUDICIALES[c.fase].toLowerCase()}`}>
                  {FASES_JUDICIALES.map((_, i) => (
                    <span class={`paso ${claseFase(i, c.fase, c.desenlace)}`} />
                  ))}
                </span>
                <span class={`situacion situacion--${c.desenlace}`}>{c.etiqueta}</span>
              </li>
            ));
            return n === 0 ? (
              <ul>{lis}</ul>
            ) : (
              lote.length > 0 && (
                <details class="mas">
                  <summary>
                    <span class="mas__ver">Ver {lote.length === 1 ? 'otra causa' : `${lote.length} causas más`}</span>
                    <span class="mas__ocultar">Ocultar</span>
                  </summary>
                  <ul>{lis}</ul>
                </details>
              )
            );
          })}
        </>
      )
    }
  </section>
</article>

<style>
  .exp {
    margin-top: 2rem;
    background: var(--papel-alto);
    border: 1px solid var(--linea);
    border-top: 8px solid var(--c);
    border-radius: 6px;
    overflow: hidden;
  }

  .exp__cabeza {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    padding: 1.5rem 2rem;
  }

  .exp__quien {
    flex: 1 1 13rem;
    max-width: 16rem;
  }

  .exp__quien h2 {
    margin: 0;
    font-size: 3.5rem;
    line-height: 1;
    font-weight: 850;
    font-stretch: 68%;
  }

  .exp__quien h2 a {
    color: var(--tinta);
    text-decoration: none;
  }

  .exp__candidato {
    margin: 0.4rem 0 0;
    font-weight: 600;
  }

  .exp__escanos {
    margin: 0.1rem 0 0;
    font-size: 0.875rem;
    color: var(--tinta-suave);
  }

  .exp__balance {
    flex: 999 1 26rem;
    min-width: 0;
  }

  .exp__rotulo {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 800;
  }

  .barra {
    display: flex;
    gap: 3px;
    height: 2.75rem;
  }

  .barra span {
    flex-basis: 0;
    display: grid;
    place-items: center;
    min-width: 1.75rem;
    border-radius: 3px;
    font-weight: 850;
    font-size: 1.125rem;
  }

  .barra__leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--tinta-suave);
  }

  .barra__leyenda span,
  .grupo__titulo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .barra__leyenda b {
    color: var(--tinta);
  }

  .barra__leyenda i,
  .grupo__titulo i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
  }

  .exp__judicial {
    flex: 1 1 17rem;
    max-width: 21rem;
    padding-left: 1.75rem;
    border-left: 1px solid var(--linea);
  }

  .contadores {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .contador {
    padding: 0.5rem 0.6rem;
    border-radius: 4px;
    background: #f1f2ee;
    color: var(--tinta-suave);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .contador b {
    display: block;
    font-size: 1.6rem;
    font-weight: 850;
    line-height: 1.05;
  }

  .contador--curso {
    background: var(--papel-alto);
    color: var(--tinta);
    box-shadow: inset 0 0 0 2px var(--tinta);
  }

  .contador--condena {
    background: #b3261e;
    color: #ffffff;
  }

  .contador--favorable {
    background: #23773a;
    color: #ffffff;
  }

  /* Propuestas a todo el ancho y, debajo, qué hizo con lo que prometió;
     cada bloque reparte su lista en columnas cuando cabe. */
  .exp__cuerpo {
    border-top: 1px solid var(--linea);
  }

  .exp__cuerpo > section {
    padding: 1.4rem 2rem;
  }

  .exp__programa {
    border-bottom: 1px solid var(--linea);
  }

  .exp__programa ul,
  .exp__hechos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
    column-gap: 2.5rem;
  }

  .exp__hechos h3 {
    grid-column: 1 / -1;
  }

  .exp h3 {
    margin: 0 0 0.6rem;
    font-size: 1.25rem;
    font-weight: 800;
  }

  .exp ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .exp__programa li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: 0.25rem 0.9rem;
    align-items: start;
    padding-block: 0.55rem;
    border-top: 1px solid #ecede9;
  }

  .exp__tema {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .exp__programa .coherencia {
    grid-column: 1;
    grid-row: 2;
  }

  .exp__propuesta {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-family: var(--serif);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .coherencia {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .coherencia::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  .coherencia--coherente {
    color: #1d5f2f;
  }

  .coherencia--parcial {
    color: #7a4d00;
  }

  .coherencia--contradictorio {
    color: #8e1b1b;
  }

  .coherencia--sin-historial {
    color: var(--tinta-suave);
  }

  /* Segundo clic: el resto de la lista se despliega en el sitio */
  .mas > summary {
    display: inline-block;
    margin-top: 0.3rem;
    cursor: pointer;
    color: var(--enlace);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .mas > summary::-webkit-details-marker {
    display: none;
  }

  .mas > summary::before {
    content: '+ ';
  }

  .mas[open] > summary::before {
    content: '− ';
  }

  .mas[open] .mas__ver,
  .mas:not([open]) .mas__ocultar {
    display: none;
  }

  .grupo {
    padding-block: 0.55rem;
    border-top: 1px solid #ecede9;
  }

  .grupo__titulo {
    margin: 0 0 0.2rem;
    font-size: 0.875rem;
    font-weight: 800;
  }

  .grupo__titulo span {
    font-weight: 600;
    color: var(--tinta-suave);
  }

  .grupo ul,
  .grupo > .mas,
  .grupo .grupo__vacio {
    margin-left: 1.1rem;
  }

  .grupo .mas ul {
    margin-left: 0;
  }

  .grupo li {
    padding-block: 0.15rem;
    line-height: 1.4;
  }

  .grupo li a,
  .causa a {
    color: var(--tinta);
    text-decoration-color: #c4c8c0;
    text-underline-offset: 0.2em;
  }

  .grupo li a:hover,
  .causa a:hover {
    text-decoration-color: currentColor;
  }

  .grupo__meta {
    margin-left: 0.35rem;
    font-size: 0.75rem;
    color: var(--tinta-suave);
  }

  .grupo__vacio {
    margin-block: 0;
    font-size: 0.875rem;
    color: var(--tinta-suave);
  }

  /* Causas judiciales: pasos del procedimiento como una línea con puntos */
  .exp__causas {
    padding: 1.4rem 2rem 1.5rem;
    border-top: 1px solid var(--linea);
  }

  .exp__causas-cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }

  .exp__causas-cabeza p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--tinta-suave);
  }

  .causa {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem 12rem;
    gap: 0.5rem 1.75rem;
    align-items: center;
    padding: 0.65rem 0.75rem;
    margin-top: 0.25rem;
    border-radius: 4px;
  }

  .causa > a {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .causa--leyenda {
    padding-block: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--tinta-suave);
  }

  .fases,
  .pasos {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    text-align: center;
  }

  .pasos {
    position: relative;
    align-items: center;
    height: 1.5rem;
  }

  .pasos::before {
    content: '';
    position: absolute;
    left: 10%;
    right: 10%;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: var(--tinta);
  }

  .paso {
    position: relative;
    justify-self: center;
    width: 0.75rem;
    height: 0.75rem;
    box-sizing: border-box;
    border-radius: 50%;
    border: 2px solid var(--tinta);
    background: var(--papel-alto);
  }

  .paso--hecho {
    background: var(--tinta);
  }

  .paso--cerrado {
    border-color: #c4c8c0;
  }

  .paso--curso {
    width: 1.1rem;
    height: 1.1rem;
    background: var(--tinta);
    box-shadow: 0 0 0 3px var(--papel-alto), 0 0 0 5px var(--tinta);
  }

  .paso--condena {
    width: 1.35rem;
    height: 1.35rem;
    border: 0;
    background: #b3261e;
    box-shadow: 0 0 0 3px var(--papel-alto), 0 0 0 5px #b3261e;
  }

  .paso--condena-no-firme {
    width: 1.25rem;
    height: 1.25rem;
    border: 4px solid #b3261e;
  }

  .paso--favorable {
    width: 1.35rem;
    height: 1.35rem;
    border: 0;
    background: #23773a;
    box-shadow: 0 0 0 3px var(--papel-alto), 0 0 0 5px #23773a;
  }

  .paso--favorable-no-firme {
    width: 1.25rem;
    height: 1.25rem;
    border: 4px solid #23773a;
  }

  .situacion {
    justify-self: start;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    border: 2px solid transparent;
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .situacion--curso {
    background: #f1f2ee;
  }

  .situacion--condena {
    background: #b3261e;
    color: #ffffff;
  }

  .situacion--condena-no-firme {
    border-color: #b3261e;
    color: #8e1b1b;
  }

  .situacion--favorable {
    background: #23773a;
    color: #ffffff;
  }

  .situacion--favorable-no-firme {
    border-color: #23773a;
    color: #1d5f2f;
  }

  .causa--condena {
    background: #fdeceb;
  }

  .causa--condena-no-firme {
    background: #fff7f6;
  }

  .causa--favorable {
    background: #e9f5ec;
  }

  .causa--favorable-no-firme {
    background: #f4faf5;
  }

  @media (max-width: 64rem) {
    .causa {
      grid-template-columns: minmax(0, 1fr) 18rem;
    }

    .causa .situacion {
      grid-column: 2;
    }

    .causa--leyenda > span:last-child {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .exp__cabeza,
    .exp__cuerpo > section,
    .exp__causas {
      padding-inline: 1rem;
    }

    .exp__quien {
      max-width: none;
    }

    .exp__quien h2 {
      font-size: 2.75rem;
    }

    .exp__judicial {
      max-width: none;
      flex-basis: 100%;
      padding-left: 0;
      border-left: 0;
    }

    .exp__programa li {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto;
    }

    .exp__programa .coherencia {
      grid-column: 2;
      grid-row: 1;
    }

    .exp__propuesta {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .causa {
      grid-template-columns: minmax(0, 1fr);
      padding-inline: 0.6rem;
    }

    .causa .situacion {
      grid-column: 1;
    }

    .causa--leyenda {
      grid-template-columns: minmax(0, 1fr);
    }

    .causa--leyenda > span:first-child {
      display: none;
    }

    .fases {
      font-size: 0.625rem;
    }
  }
</style>
