---
import { partidoUrl, type Partido } from '../lib/datos';

interface Props {
  partido: Partido;
}

const { partido: p } = Astro.props;
const d = p.data;
---

<a class="cp" href={partidoUrl(p.id)} style={`--c:${d.color}`}>
  <span class="cp__siglas">{d.siglas}</span>
  <span class="cp__nombre">{d.nombre}</span>
  <span class="cp__candidato">{d.candidato}</span>
  <span class="cp__escanos">
    <span><b>{d.escanos2023}</b> escaños en 2023</span>
    <span><b>{d.encuesta.escanos}</b> en la media de encuestas</span>
  </span>
</a>

<style>
  .cp {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.85rem 0 0.9rem;
    border-top: 6px solid var(--c);
    color: var(--tinta);
    text-decoration: none;
  }

  .cp:hover .cp__siglas {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }

  .cp__siglas {
    font-size: 1.9rem;
    font-weight: 850;
    font-stretch: 70%;
    line-height: 1;
  }

  .cp__nombre {
    font-size: 0.875rem;
    color: var(--tinta-suave);
  }

  .cp__candidato {
    font-weight: 600;
    margin-top: 0.3rem;
  }

  .cp__escanos {
    display: flex;
    flex-direction: column;
    font-size: 0.8125rem;
    color: var(--tinta-suave);
    margin-top: 0.3rem;
    font-variant-numeric: tabular-nums;
  }

  .cp__escanos b {
    color: var(--tinta);
  }
</style>
