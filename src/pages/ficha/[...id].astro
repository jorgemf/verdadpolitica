---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Marca from '../../components/Marca.astro';
import Fuentes from '../../components/Fuentes.astro';
import {
  fichas,
  partidos,
  CATEGORIA_INFO,
  ESTADO_JUDICIAL,
  AMBITO,
  LEGISLATURA,
  fichaUrl,
  partidoUrl,
  temaUrl,
  editarUrl,
  fecha,
  REPO,
  type Ficha,
  type Partido,
} from '../../lib/datos';
import { nombreTema } from '../../data/temas';

export async function getStaticPaths() {
  const todas = await fichas();
  const lista = await partidos();
  return todas.map((ficha) => ({
    params: { id: ficha.id },
    props: { ficha, todas, lista },
  }));
}

interface Props {
  ficha: Ficha;
  todas: Ficha[];
  lista: Partido[];
}

const { ficha, todas, lista } = Astro.props;
const d = ficha.data;
const partido = lista.find((p) => p.id === d.partido.id)!;
const { Content } = await render(ficha);

// Lo mismo, en los demás partidos: la invitación a no leer una sola ideología.
const otros = lista
  .filter((p) => p.id !== partido.id)
  .map((p) => ({
    partido: p,
    items: todas.filter((f) => f.data.partido.id === p.id && f.data.categoria === d.categoria).slice(0, 2),
  }));

// Estados en los que aún cabe recurso o no hay sentencia firme.
const ESTADOS_RESUELTOS = ['condena-firme', 'absolucion', 'archivado', 'archivo-fiscalia', 'sancion-anulada'];
const mostrarAviso = !!d.estadoJudicial && !ESTADOS_RESUELTOS.includes(d.estadoJudicial);

const tituloIssue = encodeURIComponent(`Corrección: ${d.titulo} (${partido.data.siglas})`);
---

<Base titulo={`${d.titulo} (${partido.data.siglas})`} descripcion={d.resumen}>
  <article class="ficha envoltorio" style={`--c:${partido.data.color}`}>
    <nav class="migas" aria-label="Ruta">
      <a href={partidoUrl(partido.id)}>{partido.data.siglas}</a>
      <span aria-hidden="true">/</span>
      <a href={`${partidoUrl(partido.id)}#${d.categoria}`}>
        <Marca categoria={d.categoria} tamano={16} />
        {CATEGORIA_INFO[d.categoria].titulo}
      </a>
    </nav>

    <h1>{d.titulo}</h1>
    <p class="ficha__resumen">{d.resumen}</p>
    <p class="ficha__comparar">
      <a href="#titulo-contraste">Ver «{CATEGORIA_INFO[d.categoria].titulo.toLowerCase()}» en los demás partidos</a>
    </p>

    <div class="ficha__rejilla">
      <aside class="ficha__lateral">
        <dl class="ficha__datos">
          {
            d.promesa && (
              <div class="ficha__promesa">
                <dt>Lo que prometió</dt>
                <dd>
                  <blockquote>{d.promesa}</blockquote>
                </dd>
              </div>
            )
          }
          {
            d.bloqueadoPor && (
              <div>
                <dt>Bloqueado por</dt>
                <dd>{d.bloqueadoPor.join(', ')}</dd>
              </div>
            )
          }
          {
            d.motivo && (
              <div>
                <dt>Por qué no lo intentó</dt>
                <dd>{d.motivo}</dd>
              </div>
            )
          }
          {
            d.estadoJudicial && (
              <div>
                <dt>Estado procesal</dt>
                <dd>
                  <span class="etiqueta etiqueta--judicial">{ESTADO_JUDICIAL[d.estadoJudicial]}</span>
                </dd>
              </div>
            )
          }
          {
            d.implicados && (
              <div>
                <dt>Implicados</dt>
                <dd>{d.implicados}</dd>
              </div>
            )
          }
          <div>
            <dt>Legislatura</dt>
            <dd>{d.legislatura} ({LEGISLATURA[d.legislatura]})</dd>
          </div>
          <div>
            <dt>Fecha clave</dt>
            <dd>{fecha(d.fecha)}</dd>
          </div>
          <div>
            <dt>Ámbito</dt>
            <dd>{AMBITO[d.ambito]}</dd>
          </div>
          {
            d.tema && (
              <div>
                <dt>Tema</dt>
                <dd>
                  <a href={temaUrl(d.tema)}>{nombreTema(d.tema)}</a>
                </dd>
              </div>
            )
          }
        </dl>

        {
          mostrarAviso && (
            <p class="ficha__aviso">
              Toda persona investigada o acusada se presume inocente mientras no exista una sentencia firme que diga lo
              contrario.
            </p>
          )
        }
      </aside>

      <div class="ficha__principal">
        <div class="prosa">
          <Content />
        </div>

        <Fuentes fuentes={d.fuentes} />

        <p class="ficha__editar">
          Última revisión: {fecha(d.actualizado)}.{' '}
          <a href={editarUrl(ficha.filePath)}>Editar esta ficha en GitHub</a> o{' '}
          <a href={`${REPO}/issues/new?template=correccion.yml&title=${tituloIssue}`}>avisar de un error</a>.
        </p>
      </div>
    </div>
  </article>

  <aside class="contraste envoltorio" aria-labelledby="titulo-contraste">
    <h2 id="titulo-contraste">
      <Marca categoria={d.categoria} />
      {CATEGORIA_INFO[d.categoria].titulo}, en los demás partidos
    </h2>
    <div class="contraste__rejilla">
      {
        otros.map(({ partido: p, items }) => (
          <div class="contraste__col" style={`--c:${p.data.color}`}>
            <h3>
              <a href={`${partidoUrl(p.id)}#${d.categoria}`}>{p.data.siglas}</a>
            </h3>
            {items.length ? (
              <ul>
                {items.map((f) => (
                  <li>
                    <a href={fichaUrl(f)}>{f.data.titulo}</a>
                  </li>
                ))}
              </ul>
            ) : (
              <p>Sin fichas en esta categoría.</p>
            )}
          </div>
        ))
      }
    </div>
  </aside>
</Base>

<style>
  .ficha {
    padding-top: 2rem;
  }

  .migas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .migas a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--tinta);
  }

  .migas a:first-child {
    border-left: 5px solid var(--c);
    padding-left: 0.5rem;
  }

  .ficha h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 850;
    font-stretch: 75%;
    max-width: 22ch;
  }

  .ficha__resumen {
    font-size: 1.2rem;
    max-width: 60ch;
    line-height: 1.45;
  }

  .ficha__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 68ch) minmax(15rem, 1fr);
    grid-template-areas: 'principal lateral';
    gap: 3rem 4rem;
    margin-top: 2rem;
    align-items: start;
  }

  .ficha__principal {
    grid-area: principal;
    min-width: 0;
  }

  .ficha__lateral {
    grid-area: lateral;
    position: sticky;
    top: calc(var(--alto-cabecera) + 1.5rem);
  }

  .ficha__comparar {
    font-weight: 600;
  }

  .ficha__datos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem 2rem;
    margin: 0 0 1rem;
    padding: 1.25rem 0;
    border-block: 1px solid var(--linea);
  }

  @media (max-width: 60rem) {
    .ficha__rejilla {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'lateral' 'principal';
      gap: 1.5rem;
    }

    .ficha__lateral {
      position: static;
    }

    .ficha__datos {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: 1rem 2rem;
    }
  }

  .ficha__datos dt {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--tinta-suave);
  }

  .ficha__datos dd {
    margin: 0.15rem 0 0;
  }

  .ficha__promesa {
    grid-column: 1 / -1;
  }

  .ficha__promesa blockquote {
    margin: 0.25rem 0 0;
    padding-left: 0.85rem;
    border-left: 4px solid var(--rotulador);
    font-family: var(--serif);
    font-size: 1.125rem;
  }

  .ficha__aviso {
    font-size: 0.9375rem;
    color: var(--tinta-suave);
    font-style: italic;
  }

  .ficha__editar {
    margin-top: 2rem;
    font-size: 0.9375rem;
    color: var(--tinta-suave);
  }

  .contraste {
    margin-top: 4rem;
  }

  .contraste h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.4rem;
  }

  .contraste__rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .contraste__col {
    border-top: 5px solid var(--c);
    padding-top: 0.75rem;
  }

  .contraste__col h3 {
    font-size: 1.2rem;
  }

  .contraste__col h3 a {
    color: var(--tinta);
  }

  .contraste__col ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .contraste__col li {
    margin-bottom: 0.5rem;
  }

  .contraste__col p {
    color: var(--tinta-suave);
  }
</style>
