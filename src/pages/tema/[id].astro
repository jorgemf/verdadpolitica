---
import Base from '../../layouts/Base.astro';
import SelectorTemas from '../../components/SelectorTemas.astro';
import VistaTema from '../../components/VistaTema.astro';
import { vistas, type Vista } from '../../lib/datos';

export async function getStaticPaths() {
  const todas = await vistas();
  return todas.map((vista) => ({ params: { id: vista.id }, props: { vista, todas } }));
}

const { vista, todas } = Astro.props as { vista: Vista; todas: Vista[] };
const titulo = vista.tema ? `${vista.nombre}: qué proponen y qué han hecho` : vista.nombre;
---

<Base titulo={titulo} descripcion={`${vista.nombre}: todos los partidos, uno junto a otro, con fuentes.`}>
  <header class="cabeza envoltorio">
    <h1>{vista.nombre}</h1>
    <p>
      {
        vista.tema
          ? 'Lo que propone cada partido para el 29-N y lo que hizo en la legislatura: lo que cumplió, lo que intentó, lo que ni intentó y dónde hizo lo contrario.'
          : 'Todos los partidos, uno junto a otro. Cada línea lleva a su ficha con fuentes.'
      }
    </p>
  </header>
  <SelectorTemas vistas={todas} actual={vista.id} />
  <div class="envoltorio cuerpo">
    <VistaTema vista={vista} />
  </div>
</Base>

<style>
  .cabeza {
    padding-block: 2rem 1.25rem;
  }

  .cabeza h1 {
    font-size: clamp(2.2rem, 6vw, 3.75rem);
    font-weight: 850;
    font-stretch: 72%;
  }

  .cabeza p {
    max-width: 62ch;
    margin: 0;
    font-size: 1.125rem;
  }

  .cuerpo {
    padding-top: 1.5rem;
  }
</style>
