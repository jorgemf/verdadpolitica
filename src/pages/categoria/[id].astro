---
import Base from '../../layouts/Base.astro';
import Marca from '../../components/Marca.astro';
import { CATEGORIAS, type Categoria } from '../../content.config';
import {
  partidos,
  fichas,
  CATEGORIA_INFO,
  ESTADO_JUDICIAL,
  AMBITO,
  fichaUrl,
  partidoUrl,
  categoriaUrl,
} from '../../lib/datos';

export async function getStaticPaths() {
  return CATEGORIAS.map((id) => ({ params: { id }, props: { categoria: id } }));
}

const { categoria } = Astro.props as { categoria: Categoria };
const info = CATEGORIA_INFO[categoria];
const lista = await partidos();
const propias = (await fichas()).filter((f) => f.data.categoria === categoria);
---

<Base titulo={info.titulo} descripcion={`${info.titulo}: todos los partidos, uno junto a otro. ${info.descripcion}`}>
  <section class="cat envoltorio">
    <nav class="cat__nav" aria-label="Categorías">
      {
        CATEGORIAS.map((c) => (
          <a href={categoriaUrl(c)} aria-current={c === categoria ? 'page' : undefined}>
            {CATEGORIA_INFO[c].corto}
          </a>
        ))
      }
    </nav>

    <h1>
      <Marca categoria={categoria} tamano={40} />
      {info.titulo}
    </h1>
    <p class="cat__intro">{info.descripcion} Todos los partidos, uno junto a otro.</p>

    <nav class="cat__partidos" aria-label="Partidos">
      {
        lista.map((p) => (
          <a href={`#${p.id}`} style={`--c:${p.data.color}`}>
            {p.data.siglas}
          </a>
        ))
      }
    </nav>

    {
      lista.map((p) => {
        const items = propias.filter((f) => f.data.partido.id === p.id);
        return (
          <section class="cat__bloque" id={p.id} style={`--c:${p.data.color}`}>
            <h2>
              <a href={partidoUrl(p.id)}>{p.data.siglas}</a>
              <span>{items.length} fichas</span>
            </h2>
            {items.length === 0 ? (
              <p class="cat__vacia">Todavía no hay fichas de este partido en esta categoría.</p>
            ) : (
              <ul>
                {items.map((f) => (
                  <li>
                    <a href={fichaUrl(f)}>{f.data.titulo}</a>
                    <p>{f.data.resumen}</p>
                    {(f.data.estadoJudicial || f.data.ambito !== 'estatal') && (
                      <p class="cat__meta">
                        {f.data.estadoJudicial && (
                          <span class="etiqueta etiqueta--judicial">{ESTADO_JUDICIAL[f.data.estadoJudicial]}</span>
                        )}
                        {f.data.ambito !== 'estatal' && <span class="etiqueta">{AMBITO[f.data.ambito]}</span>}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        );
      })
    }
  </section>
</Base>

<style>
  .cat {
    padding-top: 2rem;
  }

  .cat__nav,
  .cat__partidos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cat__nav {
    margin-bottom: 2rem;
  }

  .cat__nav a,
  .cat__partidos a {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--linea);
    border-radius: 999px;
    color: var(--tinta);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    background: var(--papel-alto);
  }

  .cat__nav a[aria-current='page'] {
    background: var(--tinta);
    color: var(--papel-alto);
    border-color: var(--tinta);
  }

  .cat__partidos {
    position: sticky;
    top: 0;
    z-index: 2;
    padding-block: 0.6rem;
    background: var(--papel);
  }

  .cat__partidos a {
    border-left: 5px solid var(--c);
  }

  .cat h1 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 850;
    font-stretch: 72%;
  }

  .cat__intro {
    max-width: 62ch;
    font-size: 1.125rem;
  }

  .cat__bloque {
    margin-top: 2.5rem;
    scroll-margin-top: 3.5rem;
  }

  .cat__bloque h2 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0 0.5rem 0.75rem;
    border-left: 6px solid var(--c);
    border-bottom: 1px solid var(--linea);
    font-size: 1.6rem;
    font-stretch: 72%;
    font-weight: 850;
  }

  .cat__bloque h2 a {
    color: var(--tinta);
    text-decoration: none;
  }

  .cat__bloque h2 span {
    font-size: 0.9375rem;
    font-weight: 500;
    font-stretch: 100%;
    color: var(--tinta-suave);
  }

  .cat__bloque ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0 2rem;
  }

  .cat__bloque li {
    padding-block: 1rem;
    border-bottom: 1px solid var(--linea);
  }

  .cat__bloque li > a {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--tinta);
  }

  .cat__bloque li p {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
  }

  .cat__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cat__vacia {
    color: var(--tinta-suave);
  }

  @media (max-width: 40rem) {
    .cat__nav,
    .cat__partidos {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }

    .cat__nav a,
    .cat__partidos a {
      flex: none;
    }
  }
</style>
