---
import Base from '../layouts/Base.astro';
import Expediente from '../components/Expediente.astro';
import {
  partidos,
  fichas,
  programa,
  temasPorPreocupacion,
  COLOR_CATEGORIA,
  CATEGORIA_INFO,
  url,
  REPO,
} from '../lib/datos';

const lista = await partidos();
const todas = await fichas();
const prog = await programa();
const temas = await temasPorPreocupacion();
---

<Base lema={false}>
  <section class="portada envoltorio">
    <div class="portada__lema">
      <p class="portada__fecha">Elecciones generales del 29 de noviembre de 2026</p>
      <h1>
        <span class="rotulador">Estás usando mal esta web si solo lees una ideología política.</span>
      </h1>
    </div>
    <div class="portada__texto">
      <p>
        Cinco expedientes, uno por partido, con la misma estructura: qué propone ahora, qué pasó con lo que prometió
        desde 2019 y cómo van sus causas judiciales. Cada línea lleva a una ficha con fuentes.
      </p>
      <p class="portada__orden">El orden de los partidos cambia en cada visita.</p>
    </div>
  </section>

  <section class="leyenda envoltorio" aria-label="Cómo leer los expedientes">
    <div class="leyenda__caja">
      <p>
        <b>Promesas:</b>
        {
          (['cumplido', 'bloqueado', 'no-intentado', 'contradiccion'] as const).map((c) => (
            <span>
              <i style={`background:${COLOR_CATEGORIA[c].fondo}`} />
              {CATEGORIA_INFO[c].titulo}
            </span>
          ))
        }
      </p>
      <p>
        <b>Causas judiciales:</b>
        <span><i class="leyenda__curso"></i>En curso</span>
        <span><i style="background:#b3261e;border-radius:50%"></i>Condena</span>
        <span><i style="background:#23773a;border-radius:50%"></i>Absuelto, archivado o sanción anulada</span>
      </p>
    </div>
  </section>

  <div class="envoltorio" data-expedientes>
    {
      lista.map((p) => (
        <Expediente
          partido={p}
          fichas={todas.filter((f) => f.data.partido.id === p.id)}
          programa={prog.filter((e) => e.data.partido.id === p.id)}
          temas={temas}
        />
      ))
    }
  </div>

  <section class="colabora envoltorio" aria-labelledby="titulo-colabora">
    <div class="colabora__caja">
      <h2 id="titulo-colabora">Esta web la mejora quien la lee</h2>
      <p>
        Todo el contenido está en GitHub y cualquiera puede proponer cambios. Si un dato está mal, falta una
        fuente o crees que tratamos a un partido con más dureza que a otro, dilo. Cada propuesta se revisa antes de
        publicarse.
      </p>
      <div class="colabora__acciones">
        <a class="boton" href={`${REPO}/issues/new/choose`}>Avisar de un error</a>
        <a class="boton boton--secundario" href={url('colabora/')}>Proponer una ficha nueva</a>
      </div>
      <p class="colabora__nota">
        Se analizan los partidos de ámbito estatal con más opciones de representación. Si quieres añadir otro (ERC,
        Junts, EH Bildu, PNV…), la guía explica cómo.
      </p>
    </div>
  </section>
</Base>

<script>
  // Ningún partido va siempre primero: los expedientes se barajan en cada visita.
  const contenedor = document.querySelector<HTMLElement>('[data-expedientes]');
  if (contenedor) {
    const expedientes = [...contenedor.querySelectorAll<HTMLElement>('[data-expediente]')];
    for (let i = expedientes.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [expedientes[i], expedientes[j]] = [expedientes[j], expedientes[i]];
    }
    contenedor.append(...expedientes);
  }

  // Enlaces a anclas de portadas anteriores: categorías y temas tienen ahora su página.
  const CATEGORIAS = ['cumplido', 'bloqueado', 'no-intentado', 'contradiccion', 'judicial'];
  const TEMAS = ['programas', 'preocupa', 'temas'];
  const ancla = decodeURIComponent(location.hash.slice(1));
  const base = document.querySelector<HTMLAnchorElement>('.logo')?.getAttribute('href') ?? '/';
  if (CATEGORIAS.includes(ancla)) location.replace(`${base}categoria/${ancla}/`);
  else if (TEMAS.includes(ancla)) location.replace(`${base}tema/vivienda/`);
  else if (ancla) document.getElementById(ancla)?.scrollIntoView();
</script>

<style>
  .portada {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1.5rem 4rem;
    padding-block: clamp(2rem, 6vw, 4rem) 1.75rem;
  }

  .portada__lema {
    flex: 999 1 34rem;
    min-width: 0;
  }

  .portada__fecha {
    font-weight: 600;
    color: var(--tinta-suave);
    margin-bottom: 0.9rem;
  }

  .portada h1 {
    margin: 0;
    font-size: clamp(2.3rem, 6.4vw, 5.25rem);
    font-weight: 850;
    font-stretch: 72%;
    line-height: 1.03;
    letter-spacing: -0.01em;
    max-width: 15ch;
  }

  .portada__texto {
    flex: 1 1 19rem;
    max-width: 24rem;
    font-size: 1.0625rem;
  }

  .portada__orden {
    margin: 0;
    font-size: 0.875rem;
    color: var(--tinta-suave);
  }

  .leyenda__caja {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    padding: 0.85rem 1.25rem;
    background: var(--papel-alto);
    border: 1px solid var(--linea);
    border-radius: 6px;
    font-size: 0.875rem;
  }

  .leyenda__caja p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin: 0;
  }

  .leyenda__caja span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .leyenda__caja i {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 3px;
  }

  .leyenda__caja .leyenda__curso {
    box-sizing: border-box;
    border: 2px solid var(--tinta);
    border-radius: 50%;
  }

  .colabora__caja {
    margin-top: 4rem;
    padding: clamp(1.25rem, 4vw, 2.75rem);
    background: var(--papel-alto);
    border: 2px solid var(--tinta);
    border-radius: 6px;
  }

  .colabora__caja h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 800;
  }

  .colabora__caja p {
    max-width: 64ch;
  }

  .colabora__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 1.5rem;
  }

  .colabora__nota {
    font-size: 0.9375rem;
    color: var(--tinta-suave);
    margin: 0;
  }
</style>
